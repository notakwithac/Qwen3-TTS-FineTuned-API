# Dockerfile for running the fine-tuning API on E2E Networks TIR
# Build:  docker build -f Dockerfile.tir -t qwen3-tts-api .
# Run:    docker run --gpus all -p 8000:8000 qwen3-tts-api
#
# Uses pip so it can reuse the base image's existing torch/CUDA packages
# and avoid re-downloading them.

FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

# System dependencies required at runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 sox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Keep the runtime Torch stack aligned with the base image during all later pip
# installs. If any dependency tries to pull a newer torch, the build should fail
# instead of silently upgrading and breaking the flash-attn ABI.
RUN printf "torch==2.8.0\ntorchvision==0.23.0\ntorchaudio==2.8.0\n" > /tmp/pytorch-constraints.txt

# Copy project files
COPY qwen_tts/ ./qwen_tts/
COPY finetuning/ ./finetuning/
COPY pyproject.toml ./

# --- Layer 1: Core ML dependencies ---
RUN pip install --no-cache-dir -c /tmp/pytorch-constraints.txt \
    "numpy<2.0.0" \
    "transformers==4.57.3" \
    "accelerate==1.12.0" \
    einops \
    requests \
    boto3 \
    psutil \
    nvidia-ml-py

# --- Layer 2: Audio / media / API dependencies ---
RUN pip install --no-cache-dir -c /tmp/pytorch-constraints.txt \
    librosa \
    soundfile \
    sox \
    pydub \
    whisperx \
    onnxruntime \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.34.0" \
    "sse-starlette>=2.1.3" \
    "broadcaster>=0.3.1" \
    "python-multipart>=0.0.18"

# --- Layer 3: optional flash-attn from pre-built wheel (GitHub can be slow) ---
ARG INSTALL_FLASH_ATTN=1
RUN if [ "$INSTALL_FLASH_ATTN" = "1" ]; then \
        pip install --no-cache-dir --no-deps \
        "https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3+cu12torch2.8cxx11abiTRUE-cp311-cp311-linux_x86_64.whl"; \
    else \
        echo "Skipping flash-attn install because INSTALL_FLASH_ATTN=$INSTALL_FLASH_ATTN"; \
    fi

# Fail the image build if the runtime drifted away from the flash-attn ABI this
# image is built for.
RUN python -c "import importlib.util, os, torch; print(f'Torch={torch.__version__} CUDA={torch.version.cuda} CXX11_ABI={torch.compiled_with_cxx11_abi()}'); assert torch.__version__.startswith('2.8.0'), f'Expected torch 2.8.0, got {torch.__version__}'; assert torch.compiled_with_cxx11_abi() is True, 'Expected torch to use CXX11 ABI for the selected flash-attn wheel'; spec = importlib.util.find_spec('flash_attn'); print(f'flash_attn={spec.origin if spec else \"missing\"}'); assert os.environ.get('INSTALL_FLASH_ATTN') != '1' or spec is not None, 'flash-attn install was requested but package is missing'"

# Copy all API / pipeline and related files
COPY *.py ./
COPY *.sh ./
RUN sed -i 's/\r$//' *.sh && chmod +x *.sh

# Expose API port
EXPOSE 8000

# Run the API server
# --- Environment Configuration (Configurable via --build-arg or -e) ---
# GPU Settings
ARG DEVICE=cuda:0
ARG USE_FLASH_ATTN=1
ARG GPU_IDLE_TIMEOUT=300
ARG GPU_MAX_MODELS=7
ARG GPU_BATCH_SIZE=32
ARG USE_TORCH_COMPILE=1

# S3 Storage (Defaulting to empty for sensitive keys)
ARG E2E_ACCESS_KEY=""
ARG E2E_SECRET_KEY=""
ARG E2E_BUCKET=pathnam-ai
ARG E2E_ENDPOINT_URL=https://s3.ap-southeast-2.amazonaws.com
ARG E2E_REGION=ap-southeast-2
ARG S3_ACCESS_KEY=""
ARG S3_SECRET_KEY=""
ARG S3_BUCKET=""
ARG S3_ENDPOINT_URL=""
ARG S3_REGION=""

# Session & Replication
ARG REPLICA_THRESHOLD=500
ARG MAX_REPLICAS_PER_MODEL=4
ARG SESSION_TIMEOUT=3600

# Voice Design
ARG MAX_CONCURRENT_VOICE_DESIGNS=4

# Massed Compute Watchdog
ARG MASSED_COMPUTE_API_TOKEN=""
ARG GPU_INSTANCE_UUID=""
ARG GPU_IDLE_THRESHOLD=5
ARG GPU_IDLE_TERMINATE_MINUTES=20

# Set ENVs from ARGs
ENV DEVICE=$DEVICE \
    USE_FLASH_ATTN=$USE_FLASH_ATTN \
    GPU_IDLE_TIMEOUT=$GPU_IDLE_TIMEOUT \
    GPU_MAX_MODELS=$GPU_MAX_MODELS \
    GPU_BATCH_SIZE=$GPU_BATCH_SIZE \
    USE_TORCH_COMPILE=$USE_TORCH_COMPILE \
    E2E_ACCESS_KEY=$E2E_ACCESS_KEY \
    E2E_SECRET_KEY=$E2E_SECRET_KEY \
    E2E_BUCKET=$E2E_BUCKET \
    E2E_ENDPOINT_URL=$E2E_ENDPOINT_URL \
    E2E_REGION=$E2E_REGION \
    S3_ACCESS_KEY=$S3_ACCESS_KEY \
    S3_SECRET_KEY=$S3_SECRET_KEY \
    S3_BUCKET=$S3_BUCKET \
    S3_ENDPOINT_URL=$S3_ENDPOINT_URL \
    S3_REGION=$S3_REGION \
    REPLICA_THRESHOLD=$REPLICA_THRESHOLD \
    MAX_REPLICAS_PER_MODEL=$MAX_REPLICAS_PER_MODEL \
    SESSION_TIMEOUT=$SESSION_TIMEOUT \
    MAX_CONCURRENT_VOICE_DESIGNS=$MAX_CONCURRENT_VOICE_DESIGNS \
    MASSED_COMPUTE_API_TOKEN=$MASSED_COMPUTE_API_TOKEN \
    GPU_INSTANCE_UUID=$GPU_INSTANCE_UUID \
    GPU_IDLE_THRESHOLD=$GPU_IDLE_THRESHOLD \
    GPU_IDLE_TERMINATE_MINUTES=$GPU_IDLE_TERMINATE_MINUTES \
    LD_LIBRARY_PATH=/opt/conda/lib/python3.11/site-packages/torch/lib:/opt/conda/lib:${LD_LIBRARY_PATH}

CMD ["/bin/bash", "/app/start_tir.sh"]
