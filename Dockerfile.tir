# Dockerfile for running the fine-tuning API on E2E Networks TIR
# Build:  docker build -f Dockerfile.tir -t qwen3-tts-api .
# Run:    docker run --gpus all -p 8000:8000 qwen3-tts-api
#
# Uses pip (not uv) for installs so it detects the base image's existing
# torch/CUDA packages and skips re-downloading them (~3 GB saved).

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

# System dependencies for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential libsndfile1 sox dos2unix \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv (kept for runtime use, not used for Docker install steps)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Copy project files
COPY pyproject.toml uv.lock ./
COPY qwen_tts/ ./qwen_tts/
COPY finetuning/ ./finetuning/
COPY MANIFEST.in ./

# --- Layer 1: Core ML dependencies ---
# pip sees the conda-installed torch and skips it (unlike uv which re-downloads)
RUN pip install --no-cache-dir \
    "numpy<2.0.0" \
    "transformers==4.57.3" \
    "accelerate==1.12.0" \
    einops \
    "tensorboard>=2.20.0" \
    requests boto3

# --- Layer 2: Audio / media / API dependencies ---
RUN pip install --no-cache-dir \
    gradio librosa soundfile sox onnxruntime \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.34.0" \
    "python-multipart>=0.0.18"

# --- Layer 3: flash-attn from pre-built wheel (own layer — GitHub can be slow) ---
RUN pip install --no-cache-dir \
    "https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3+cu12torch2.5cxx11abiFALSE-cp311-cp311-linux_x86_64.whl"

# --- Layer 4: Install the project package itself (no deps, just the code) ---
RUN pip install --no-cache-dir --no-deps -e .

# --- Layer 5: Create .venv for start_tir.sh compatibility ---
# --system-site-packages gives the venv access to everything installed above
RUN python -m venv --system-site-packages .venv

# Copy all API / pipeline and related files
COPY *.py ./
COPY *.sh ./
RUN dos2unix *.sh

# Expose API port
EXPOSE 8000

# Run the API server
# --- Environment Configuration (Configurable via --build-arg or -e) ---
# GPU Settings
ARG DEVICE=cuda:0
ARG USE_FLASH_ATTN=1
ARG GPU_IDLE_TIMEOUT=300
ARG GPU_MAX_MODELS=7
ARG GPU_BATCH_SIZE=32
ARG USE_TORCH_COMPILE=1

# S3 Storage (Defaulting to empty for sensitive keys)
ARG E2E_ACCESS_KEY=""
ARG E2E_SECRET_KEY=""
ARG E2E_BUCKET=pathnam-ai
ARG E2E_ENDPOINT_URL=https://s3.ap-southeast-2.amazonaws.com
ARG E2E_REGION=ap-southeast-2

# Session & Replication
ARG REPLICA_THRESHOLD=500
ARG MAX_REPLICAS_PER_MODEL=4
ARG SESSION_TIMEOUT=3600

# Voice Design
ARG MAX_CONCURRENT_VOICE_DESIGNS=4

# Massed Compute Watchdog
ARG MASSED_COMPUTE_API_TOKEN=""
ARG GPU_INSTANCE_UUID=""
ARG GPU_IDLE_THRESHOLD=5
ARG GPU_IDLE_TERMINATE_MINUTES=20

# Set ENVs from ARGs
ENV DEVICE=$DEVICE \
    USE_FLASH_ATTN=$USE_FLASH_ATTN \
    GPU_IDLE_TIMEOUT=$GPU_IDLE_TIMEOUT \
    GPU_MAX_MODELS=$GPU_MAX_MODELS \
    GPU_BATCH_SIZE=$GPU_BATCH_SIZE \
    USE_TORCH_COMPILE=$USE_TORCH_COMPILE \
    E2E_ACCESS_KEY=$E2E_ACCESS_KEY \
    E2E_SECRET_KEY=$E2E_SECRET_KEY \
    E2E_BUCKET=$E2E_BUCKET \
    E2E_ENDPOINT_URL=$E2E_ENDPOINT_URL \
    E2E_REGION=$E2E_REGION \
    REPLICA_THRESHOLD=$REPLICA_THRESHOLD \
    MAX_REPLICAS_PER_MODEL=$MAX_REPLICAS_PER_MODEL \
    SESSION_TIMEOUT=$SESSION_TIMEOUT \
    MAX_CONCURRENT_VOICE_DESIGNS=$MAX_CONCURRENT_VOICE_DESIGNS \
    MASSED_COMPUTE_API_TOKEN=$MASSED_COMPUTE_API_TOKEN \
    GPU_INSTANCE_UUID=$GPU_INSTANCE_UUID \
    GPU_IDLE_THRESHOLD=$GPU_IDLE_THRESHOLD \
    GPU_IDLE_TERMINATE_MINUTES=$GPU_IDLE_TERMINATE_MINUTES

CMD ["bash", "start_tir.sh"]
