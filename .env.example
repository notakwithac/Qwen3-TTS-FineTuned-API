# Qwen3-TTS API — Environment Configuration

# ---------------------------------------------------------------------------
# Resource Isolation
# ---------------------------------------------------------------------------
# If 1, allows inference and training to run at the same time on the same GPU.
# If 0, inference will wait for training to finish (and training will wait for inferences to drain).
# Default: Automatically determined (1 for 40GB+ VRAM, 0 otherwise).
ALLOW_CONCURRENT_TRAINING_INFERENCE=0

# --- GPU Settings ---
DEVICE=cuda:0
USE_FLASH_ATTN=1
GPU_IDLE_TIMEOUT=0
# Throughput mode recommendation: keep hot shared models resident to avoid
# repeated load/compile churn. Set to a large value instead if you still want
# eventual auto-unload after idle periods.
GPU_MAX_MODELS=7
# Max cached models in VRAM simultaneously (~5.5 GB each). This is a capacity budget,
# not an automatic "spawn this many shared replicas" switch. Keep this high to
# leave room for custom checkpoints alongside the shared hot models. The runtime
# API can override the live value without redeploying.
GPU_BATCH_SIZE=32
# Max texts per inference batch
VOICE_CLONE_API_BATCH_SIZE=10
# Max items the /voice-clone API will fuse into a single GPU step.
USE_TORCH_COMPILE=1  
# Enable torch.compile for faster repeated inference (uses "default" mode)
DATASET_PREP_DEVICE=auto
# Dataset prep WhisperX device: auto, cuda, or cpu. Auto prefers CUDA but falls back on OOM.
DATASET_WHISPER_MODEL=turbo
# Override if you want higher accuracy and have enough free VRAM for a larger WhisperX model.
# Optional: DATASET_PREP_CUDA_MIN_FREE_GB=10
VOICE_DESIGN_REPLICAS=1
# Throughput mode recommendation: preload and keep one hot VoiceDesign replica.
# Higher targets are allowed, but extra replicas still require real free VRAM.
VOICE_CLONE_REPLICAS=1
# Throughput mode recommendation: preload and keep one hot Base replica for clone
# workloads. Prefer batching before increasing this target.
SHARED_MODEL_MIN_HEADROOM_GB=4
# Minimum free headroom required before loading an additional shared replica.
# This can also be overridden at runtime without restarting the process.

# --- S3 Storage Settings ---
# If using AWS S3: 
#   ENDPOINT_URL should be empty or https://s3.amazonaws.com
#   REGION should be your AWS region (e.g., us-east-1)
# If using E2E Object Storage:
#   ENDPOINT_URL=https://objectstore.e2enetworks.net
#   REGION=us-east-1

E2E_ACCESS_KEY=
E2E_SECRET_KEY=
E2E_BUCKET=
E2E_ENDPOINT_URL=
E2E_REGION=

# --- HuggingFace (Optional, but recommended for diarization) ---
# Needed for pyannote diarization-based speaker cropping during dataset preparation.
# Without it, dataset prep now falls back to single-speaker transcript mode.
# HF_TOKEN=your_hf_token

# --- Session & Replication (Event-Driven Inference) ---
REPLICA_THRESHOLD=500
# Lines before adding replicas per character
MAX_REPLICAS_PER_MODEL=4
# Max replicas of same model on GPU
SESSION_TIMEOUT=3600
# Auto-cleanup inactive sessions (seconds)
SESSION_BATCH_MAX_CHARS=4000
# Raw text+instruct char budget for one custom-voice session worker GPU step.
CUSTOM_VOICE_SESSION_BATCH_SIZE=1
# Max items a custom-voice session worker will run in one internal GPU sub-batch.
# Set to 1 to keep custom_voice inference strictly serial.
CUSTOM_VOICE_API_BATCH_SIZE=1
# Max items the /infer/{job_id}/batch API will fuse into a single custom_voice GPU step.
CUSTOM_VOICE_SESSION_BATCH_PADDED_CHARS=2000
# Padding-aware budget for one custom-voice session worker GPU step.
# Estimated as (items in sub-batch * longest item char cost).
CUSTOM_VOICE_SESSION_DO_SAMPLE=1
# Keep sampling on for narration, but narrow it enough to avoid runaway low-confidence tails.
CUSTOM_VOICE_SESSION_SUBTALKER_DO_SAMPLE=1
CUSTOM_VOICE_SESSION_TEMPERATURE=0.7
CUSTOM_VOICE_SESSION_TOP_P=0.85
CUSTOM_VOICE_SESSION_MAX_NEW_TOKENS=4096
CUSTOM_VOICE_SESSION_MIN_NEW_TOKENS=512
CUSTOM_VOICE_SESSION_MAX_NEW_TOKENS_PER_CHAR=4

# --- Voice Design ---
MAX_CONCURRENT_VOICE_DESIGNS=32
# Max items in a single /voice-design/batch call. Match GPU_BATCH_SIZE for best fusion.
BATCH_STORAGE_CONCURRENCY=8
# Parallel S3 existence checks/uploads for batch endpoints

# --- Massed Compute Auto-Termination (gpu_idle_watchdog.py) ---
MASSED_COMPUTE_API_TOKEN=

GPU_INSTANCE_UUID=
GPU_IDLE_TERMINATE_MINUTES=20
# Minutes of sustained idle before VM terminates

# --- Periodic Heartbeat Uploads (Anti-Data-Loss) ---
GPU_PERIODIC_UPLOAD_MINUTES=5
# Upload logs/metrics/checkpoints even if GPU is busy every N minutes
GPU_UPLOAD_OUTPUTS=true
# Whether to include training weights/checkpoints in heartbeats (bandwidth intensive)

GPU_IDLE_THRESHOLD=5
# % utilization below which GPU = idle
