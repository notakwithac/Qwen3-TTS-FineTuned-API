		{
			"name": "Speech Generation",
			"item": [
				{
					"name": "Single Inference",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"Hello, welcome to our audiobook. This is a fine-tuned voice!\",\n    \"language\": \"English\",\n    \"upload_to_s3\": true,\n    \"overwrite\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/infer/:job_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"infer",
								":job_id"
							],
							"variable": [
								{
									"key": "job_id",
									"value": "your_ready_job_id"
								}
							]
						},
						"description": "Generate a single audio file for a given text using a 'READY' fine-tuned model."
					},
					"response": []
				},
				{
					"name": "Batch Inference",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": [\n        {\"text\": \"Chapter one begins here.\", \"filename\": \"ch1_001.wav\"},\n        {\"text\": \"The journey was just starting.\", \"filename\": \"ch1_002.wav\"}\n    ],\n    \"language\": \"English\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/infer/:job_id/batch",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"infer",
								":job_id",
								"batch"
							],
							"variable": [
								{
									"key": "job_id",
									"value": "your_ready_job_id"
								}
							]
						}
					},
					"response": []
				},
