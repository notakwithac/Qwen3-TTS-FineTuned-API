							"mode": "raw",
							"raw": "{\n    \"ref_audio_url\": \"https://example.com/sample.wav\",\n    \"ref_text\": \"Original transcript of the reference audio.\",\n    \"items\": [\n        {\"text\": \"New sentence in the cloned voice.\", \"filename\": \"clone_01.wav\"}\n    ],\n    \"language\": \"English\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/voice-clone/batch",
