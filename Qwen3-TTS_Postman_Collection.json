    "info": {
        "_postman_id": "6a3fe033-b1d6-4e50-a92c-7b06b2cd8df6",
        "name": "Qwen3-TTS API",
        "description": "Postman Collection for Qwen3-TTS Fine-Tuning API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "GPU Management",
            "item": [
                {
                    "name": "Terminate Instance",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/gpu/terminate",
                            "host": ["{{base_url}}"],
                            "path": ["gpu", "terminate"]
                        },
                        "description": "Request instance termination. Puts the server into DRAINING mode (rejects new POST requests) and creates a terminate_signal.tmp file that the GPU watchdog monitors. The instance will be terminated once all active operations complete."
                    },
                    "response": []
                },
                {
                    "name": "Cancel Terminate",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/gpu/cancel-terminate",
                            "host": ["{{base_url}}"],
                            "path": ["gpu", "cancel-terminate"]
                        },
                        "description": "Cancel a pending termination request. Resets IS_DRAINING to false so the server accepts new work again, and deletes the terminate_signal.tmp file so the watchdog stops monitoring for termination."
                    },
                    "response": []
                },
                {
                    "name": "GPU Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/gpu/status",
                            "host": ["{{base_url}}"],
                            "path": ["gpu", "status"]
                        },
                        "description": "Get GPU memory usage, model load state, and idle timer info."
                    },
                    "response": []
                }
            ]
        },

        {
            "name": "Voice Design",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"text\": \"Welcome to this audiobook. This voice was generated entirely from a text description.\",\n    \"instruct\": \"A warm male voice, middle-aged, calm and authoritative\",\n    \"language\": \"English\",\n    \"upload_to_s3\": true,\n    \"overwrite\": false\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/voice-design",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "voice-design"
                    ]
                },
                "description": "Generate speech from a text description of the desired voice, using the VoiceDesign model directly."
            },
            "response": []
        },
        {
            "name": "Voice Clone (Batch)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"ref_audio_url\": \"https://github.com/gradio-app/gradio/raw/main/test/test_files/audio_sample.wav\",\n    \"ref_text\": \"Beavers are second only to humans in their ability to manipulate their environment.\",\n    \"items\": [\n        {\n            \"text\": \"First sentence to generate in this newly cloned voice.\",\n            \"filename\": \"clone_001.wav\"\n        },\n        {\n            \"text\": \"Second sentence to generate concurrently.\",\n            \"filename\": \"clone_002.wav\"\n        }\n    ],\n    \"language\": \"English\",\n    \"upload_to_s3\": true,\n    \"overwrite\": false,\n    \"use_xvec\": false\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/voice-clone/batch",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "voice-clone",
                        "batch"
                    ]
                },
                "description": "Batch generate zero-shot voice cloning from a reference audio and text. Uses the Qwen3-TTS Base model."
            },
            "response": []
        }
    ],
