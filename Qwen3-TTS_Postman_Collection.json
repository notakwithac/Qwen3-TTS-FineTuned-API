	"item": [
		{
			"name": "Job Lifecycle",
			"item": [
				{
					"name": "Start Fine-Tuning",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dataset_s3_key\": \"datasets/Hero1/dataset.zip\",\n    \"speaker_name\": \"hero_voice\",\n    \"num_epochs\": 15,\n    \"batch_size\": 2,\n    \"lr\": 1e-6,\n    \"force\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/finetune",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"finetune"
							]
						},
						"description": "Start a new fine-tuning job using a dataset stored on S3."
					},
					"response": []
				},
				{
